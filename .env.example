# Frontend Environment Variables (Exposed to Vite client with VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Backend / Supabase Edge Functions Secrets
# NOTE: Never prefix backend secrets with VITE_.
# Configure these securely in Supabase Dashboard / CLI secrets:
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

